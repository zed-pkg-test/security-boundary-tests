{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orestra.dev/schemas/v1alpha1/namespace.schema.json",
  "title": "Orestra Namespace v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "orestra.io/v1alpha1"
    },
    "kind": {
      "const": "Namespace"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "namespace",
        "uid",
        "generation",
        "resourceVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "resourceVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "deletionTimestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "quota": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpuMillis": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "memoryBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000000000000
            },
            "maxWorkloads": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          }
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phase": {
          "enum": [
            "Active",
            "Terminating"
          ]
        }
      }
    }
  }
}
