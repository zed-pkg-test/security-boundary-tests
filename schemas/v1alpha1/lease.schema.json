{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orestra.dev/schemas/v1alpha1/lease.schema.json",
  "title": "Orestra lease v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "orestra.io/v1alpha1"
    },
    "kind": {
      "const": "Lease"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "namespace",
        "uid",
        "generation",
        "resourceVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854776000
        },
        "resourceVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "deletionTimestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "holder",
        "epoch",
        "expiresAt"
      ],
      "additionalProperties": false,
      "properties": {
        "holder": {
          "type": "string",
          "minLength": 1
        },
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854776000
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
