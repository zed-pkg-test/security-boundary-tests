{
  "apiVersion": "orestra.io/v1alpha1",
  "kind": "DriverManifest",
  "metadata": {
    "name": "cni-bridge",
    "version": "0.1.0-alpha"
  },
  "spec": {
    "category": "network",
    "abi": {
      "min": 1,
      "max": 1
    },
    "platforms": [
      "linux/amd64",
      "linux/arm64"
    ],
    "implementation": "external-cni-adapter",
    "runtimeContract": "CNI",
    "sandbox": {
      "requires": [
        "net-namespace",
        "netlink"
      ],
      "mustDeny": [
        "unauthorized-host-route"
      ]
    },
    "status": "planned"
  }
}
