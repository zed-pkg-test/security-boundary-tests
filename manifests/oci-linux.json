{
  "apiVersion": "orestra.io/v1alpha1",
  "kind": "DriverManifest",
  "metadata": {
    "name": "oci-linux",
    "version": "0.1.0-alpha"
  },
  "spec": {
    "category": "runtime",
    "abi": {
      "min": 1,
      "max": 1
    },
    "platforms": [
      "linux/amd64",
      "linux/arm64"
    ],
    "implementation": "orestra-os-adapter",
    "runtimeContract": "OCI",
    "sandbox": {
      "requires": [
        "mount-namespace",
        "pid-namespace",
        "user-namespace",
        "cgroups-v2",
        "seccomp"
      ],
      "mustDeny": [
        "untrusted-host-exec",
        "rootless-bypass"
      ]
    },
    "status": "planned"
  }
}
